,{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareStrings"},"parameters":["ACTUAL_JOY","=","\"RIGHT\""]}],"actions":[{"type":{"value":"SetX"},"parameters":["Object","+","GLOBAL_SPEED * TimeDelta()"]}]}]},{"type":"BuiltinCommonInstructions::Else","conditions":[],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["ACTUAL_JOY","=","\"\""]}]}]}]}],"parameters":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["Template","!=","\"RPG\""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","BINDING[Template].UP[Retro]"]}],"actions":[{"type":{"value":"SetY"},"parameters":["Object","-","GLOBAL_SPEED * TimeDelta()"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","BINDING[Template].DOWN[Retro]"]}],"actions":[{"type":{"value":"SetY"},"parameters":["Object","+","GLOBAL_SPEED * TimeDelta()"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","BINDING[Template].LEFT[Retro]"]}],"actions":[{"type":{"value":"SetX"},"parameters":["Object","-","GLOBAL_SPEED * TimeDelta()"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","BINDING[Template].RIGHT[Retro]"]}],"actions":[{"type":{"value":"SetX"},"parameters":["Object","+","GLOBAL_SPEED * TimeDelta()"]}]}]},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["Template","=","\"RPG\""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["GLOBAL_ACTUAL_KEY","=","LastPressedKey()"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type